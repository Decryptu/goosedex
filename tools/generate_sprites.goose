// Build-time sprite embedder. Replays every ANSI colorscript into a pixel
// grid, encodes it (layout below, rendered by src/sprites.goose), compresses
// each Pokemon's regular and shiny sprites as one DEFLATE stream, and writes
// data.bin with the Goose module that indexes it, embedded_sprites.goose.
//
// Usage: generate_sprites <pokemon.json> <colorscripts_dir> <output_dir>

import std;
import os;
import json;
import dictionary;
import deflate;

// Colors are 0xRRGGBB; -1 is transparent.
let TRANSPARENT = -1;

// Table rows per chunk in the generated module.
let CHUNK = 256;

// One terminal cell holds two vertical pixels.
struct Cell { top: i32, bottom: i32 }

struct Sprite { width: i64, cells: Cell[>..] }

struct Species { idx: i64, slug: u8[..64], name: u8[..64] }
struct Form { species: i64, form: u8[..64] }

struct Entry {
    idx: i64,
    slug: u8[..64],
    name: u8[..64],
    offset: i64,
    len: i64,
    regular_len: i64,
    shiny_len: i64,
}

struct Key { key: u8[..64], index: i64 }

// A byte range of the embedded data.
struct Span { start: i64, len: i64 }

fn fail(path: const u8[:], what: const u8[:]) { abort(str(path, ": ", what)); }

fn main() {
    let argv = args();
    if argv.len != 4 {
        write_stderr(str("Usage: ", argv[0], " <pokemon.json> <colorscripts_dir> <output_dir>\n"));
        exit(1);
    }
    let sprites_dir = argv[2];
    let out_dir = argv[3];

    var json_text: u8[>..] = [];
    if !read_file(argv[1], json_text) { fail(argv[1], "cannot read"); }
    var species: Species[>..] = [];
    var forms: Form[>..] = [];
    read_pokedex(argv[1], json_text, species, forms);

    var entries: Entry[>..] = [];
    var blob: u8[>..] = [];
    for s in species {
        if s.idx != entries.len + 1 { fail(argv[1], "pokedex is not contiguous"); }
        entries.push(add_entry(sprites_dir, blob, s.idx, s.slug, s.name));
    }
    let pokemon_count = entries.len;
    for f in forms {
        let base .= species[f.species];
        var slug: u8[..64] = [];
        format(slug, base.slug, "-", f.form);
        var name: u8[..64] = [];
        form_display_name(name, base.name, f.form);
        entries.push(add_entry(sprites_dir, blob, base.idx, slug, name));
    }

    // Earlier keys win on collision, preserving lookup precedence: slugs
    // before names, species before forms.
    var keys: Key[>..] = [];
    var seen = dictionary<u8[..64], bool> {};
    for by_slug in [true, false] {
        for e, i in entries {
            var key: u8[..64] = [];
            key.append(if by_slug { e.slug } else { e.name });
            to_lower(key);
            if seen.insert(key, true) { keys.push(Key { key: key, index: i }); }
        }
    }
    sort(keys) { a, b => compare(a.key, b.key) < 0 };

    // Tables hold offsets into the embedded data, which also holds every
    // string once.
    var interned = dictionary<u8[..64], Span> {};
    fn intern(text: const u8[:]) -> Span {
        var key: u8[..64] = [];
        key.append(text);
        let found = interned.get(key);
        if found { return found; }
        let span = Span { start: blob.len, len: text.len };
        blob.append(text);
        interned.insert(key, span);
        return span;
    }

    var src: u8[>..] = [];
    src.append("""
        // Generated by tools/generate_sprites.goose from assets/; do not edit.

        // A byte range of DATA.
        struct Span { start: u32, len: u32 }

        struct Pokemon {
            idx: u16,
            slug: Span,
            name: Span,
            // Raw DEFLATE stream of the encoded regular sprite followed by the shiny one.
            sprites: Span,
            regular_len: u32,
            shiny_len: u32,
        }

        struct Key { key: Span, index: u16 }

        let DATA = embed_file("data.bin");

        // The compiler keeps a fixed array in static data only up to 256
        // elements, and builds a longer one at startup, so the tables are
        // arrays of such chunks.
        let CHUNK = 256;

        fn pokemon(i: i64) -> const Pokemon& { POKEMON[i / CHUNK][i % CHUNK] }
        fn key(i: i64) -> const Key& { KEYS[i / CHUNK][i % CHUNK] }

        """);
    format(src, "let POKEMON_COUNT = ", pokemon_count, ";\n");
    format(src, "let ENTRY_COUNT = ", entries.len, ";\n");
    format(src, "let KEY_COUNT = ", keys.len, ";\n\n");
    let chunks = (entries.len + CHUNK - 1) / CHUNK;
    format(src, "// National dex species in order, followed by alternate forms.\n");
    format(src, "const POKEMON: Pokemon[CHUNK][", chunks, "] = [\n");
    for i in chunks * CHUNK {
        if i % CHUNK == 0 { src.append("  [\n"); }
        if i < entries.len {
            let e .= entries[i];
            let slug = intern(e.slug);
            let name = intern(e.name);
            format(src, "    Pokemon { ", e.idx, ", Span { ", slug.start, ", ", slug.len, " }, Span { ",
                   name.start, ", ", name.len, " }, Span { ", e.offset, ", ", e.len, " }, ",
                   e.regular_len, ", ", e.shiny_len, " },\n");
        } else {
            src.append("    Pokemon { 0, Span { 0, 0 }, Span { 0, 0 }, Span { 0, 0 }, 0, 0 },\n");
        }
        if i % CHUNK == CHUNK - 1 { src.append("  ],\n"); }
    }
    let key_chunks = (keys.len + CHUNK - 1) / CHUNK;
    format(src, "];\n\n// Lowercase slugs and names, sorted for binary search.\n");
    format(src, "const KEYS: Key[CHUNK][", key_chunks, "] = [\n");
    for i in key_chunks * CHUNK {
        if i % CHUNK == 0 { src.append("  [\n"); }
        if i < keys.len {
            let key = intern(keys[i].key);
            format(src, "    Key { Span { ", key.start, ", ", key.len, " }, ", keys[i].index, " },\n");
        } else {
            src.append("    Key { Span { 0, 0 }, 0 },\n");
        }
        if i % CHUNK == CHUNK - 1 { src.append("  ],\n"); }
    }
    src.append("];\n");

    if !make_dir(out_dir) { fail(out_dir, "cannot create"); }
    let data_path = str(out_dir, "/data.bin");
    if !write_file(data_path, blob) { fail(data_path, "cannot write"); }
    let src_path = str(out_dir, "/embedded_sprites.goose");
    if !write_file(src_path, src) { fail(src_path, "cannot write"); }
}

// Collects each species, and each alternate form with the species it belongs to.
fn read_pokedex(path: const u8[:], text: const u8[:], species: Species[>..]&, forms: Form[>..]&) {
    var r = json::reader(text);
    var scratch: u8[>..] = [];
    json::each_element(r) {
        var s = Species { idx: 0, slug: "", name: "" };
        json::each_member(r) { key =>
            if key == "idx" {
                s.idx = json::read_int(r);
            } else if key == "slug" {
                s.slug.append(json::read_string(r, scratch));
            } else if key == "name" {
                json::each_member(r) { lang =>
                    if lang == "en" { s.name.append(json::read_string(r, scratch)); }
                    else { json::skip(r); }
                };
            } else if key == "forms" {
                json::each_element(r) {
                    var f = Form { species: species.len, form: "" };
                    f.form.append(json::read_string(r, scratch));
                    forms.push(f);
                };
            } else {
                json::skip(r);
            }
        };
        species.push(s);
    };
    if !json::finish(r) { fail(path, json::message(r)); }
}

fn add_entry(dir: const u8[:], blob: u8[>..]&, idx: i64, slug: const u8[:], name: const u8[:]) -> Entry {
    var encoded: u8[>..] = [];
    let regular = load_sprite(dir, "regular", slug);
    encode(encoded, regular);
    let regular_len = encoded.len;
    let shiny_path = str(dir, "/shiny/", slug);
    if file_exists(shiny_path) {
        let shiny = load_sprite(dir, "shiny", slug);
        encode(encoded, shiny);
    } else {
        encode(encoded, regular);
    }

    let offset = blob.len;
    deflate::deflate(blob, encoded, regular_len);
    var e = Entry { idx: idx, slug: "", name: "", offset: offset, len: blob.len - offset,
                    regular_len: regular_len, shiny_len: encoded.len - regular_len };
    e.slug.append(slug);
    e.name.append(name);
    return e;
}

fn load_sprite(dir: const u8[:], variant: const u8[:], slug: const u8[:]) -> Sprite {
    let path = str(dir, "/", variant, "/", slug);
    var text: u8[>..] = [];
    if !read_file(path, text) { fail(path, "cannot read"); }
    var parsed = Sprite { width: 0, cells: [] };
    parse(path, text, parsed);
    var sprite = Sprite { width: 0, cells: [] };
    crop(path, parsed, sprite);
    return sprite;
}

// Replays the ANSI text like a terminal would, recording what each cell shows.
fn parse(path: const u8[:], text: const u8[:], s: Sprite&) {
    var row_start = 0;
    var fg: i32 = TRANSPARENT;
    var bg: i32 = TRANSPARENT;
    var i = 0;
    while i < text.len {
        let rest = text[i..];
        if starts_with(rest, "\x1b[") {
            let end = position(rest, 'm');
            if end < 0 { fail(path, "bad escape"); }
            apply_sgr(path, rest[2..end], fg, bg);
            i += end + 1;
        } else if rest[0] == '\n' {
            let row_len = s.cells.len - row_start;
            if row_len != 0 {
                if s.width != 0 && s.width != row_len { fail(path, "ragged rows"); }
                s.width = row_len;
            }
            row_start = s.cells.len;
            i++;
        } else if rest[0] == ' ' {
            s.cells.push(Cell { top: bg, bottom: bg });
            i++;
        } else if starts_with(rest, "▀") {
            s.cells.push(Cell { top: fg, bottom: bg });
            i += "▀".len;
        } else if starts_with(rest, "▄") {
            s.cells.push(Cell { top: bg, bottom: fg });
            i += "▄".len;
        } else {
            fail(path, "unexpected byte");
        }
    }
    if s.cells.len != row_start { fail(path, "missing final newline"); }
    if s.width == 0 { fail(path, "empty sprite"); }
}

fn apply_sgr(path: const u8[:], params: const u8[:], fg: i32&, bg: i32&) {
    var values: i64[16] = [0; 16];
    var n = 0;
    each_split(params, ';') {
        if n == values.len { fail(path, "bad escape"); }
        var v = 0;
        if it.len > 0 {
            let parsed, ok = parse_int(it);
            if !ok || parsed < 0 || parsed > 255 { fail(path, "bad escape"); }
            v = parsed;
        }
        values[n] = v;
        n++;
    };

    var i = 0;
    while i < n {
        let v = values[i];
        if v == 0 {
            fg = TRANSPARENT;
            bg = TRANSPARENT;
        } else if v == 39 {
            fg = TRANSPARENT;
        } else if v == 49 {
            bg = TRANSPARENT;
        } else if v == 38 || v == 48 {
            var color: i32 = 0;
            if i + 2 < n && values[i + 1] == 5 {
                color = xterm256(values[i + 2]);
                i += 2;
            } else if i + 4 < n && values[i + 1] == 2 {
                color = (values[i + 2] << 16 | values[i + 3] << 8 | values[i + 4]) as i32;
                i += 4;
            } else {
                fail(path, "bad escape");
            }
            if v == 38 { fg = color; } else { bg = color; }
        } else {
            fail(path, "unsupported SGR");
        }
        i++;
    }
}

// Resolves 256-color indices with xterm's default palette so every sprite
// renders in truecolor.
fn xterm256(n: i64) -> i32 {
    const system: i32[16] = [0x000000, 0xcd0000, 0x00cd00, 0xcdcd00, 0x0000ee, 0xcd00cd, 0x00cdcd, 0xe5e5e5,
                             0x7f7f7f, 0xff0000, 0x00ff00, 0xffff00, 0x5c5cff, 0xff00ff, 0x00ffff, 0xffffff];
    if n < 16 { return system[n]; }
    if n < 232 {
        const levels: i32[6] = [0, 95, 135, 175, 215, 255];
        let i = n - 16;
        return levels[i / 36] << 16 | levels[i / 6 % 6] << 8 | levels[i % 6];
    }
    let gray = (8 + 10 * (n - 232)) as i32;
    return gray << 16 | gray << 8 | gray;
}

fn is_blank(c: Cell) -> bool { c.top == TRANSPARENT && c.bottom == TRANSPARENT }

// Drops fully transparent border rows and columns.
fn crop(path: const u8[:], s: Sprite&, out: Sprite&) {
    let height = s.cells.len / s.width;
    var top = height;
    var bottom = 0;
    var left = s.width;
    var right = 0;
    for y in height {
        for x in s.width {
            guard !is_blank(s.cells[y * s.width + x]);
            top = min(top, y);
            bottom = max(bottom, y + 1);
            left = min(left, x);
            right = max(right, x + 1);
        }
    }
    if top == height { fail(path, "empty sprite"); }
    out.width = right - left;
    for y in top..bottom { out.cells.append(s.cells[y * s.width + left..y * s.width + right]); }
}

// Writes the layout src/sprites.goose renders: width, height, a little-endian
// u16 palette length, the RGB palette, then a top and bottom palette index per
// cell where 0 is transparent. Indices are u16 when the palette has more than
// 255 colors.
fn encode(out: u8[>..]&, s: Sprite&) {
    let height = s.cells.len / s.width;
    if s.width > 255 || height > 255 { abort("sprite too large"); }

    var palette: i32[>..] = [];
    var index = dictionary<i32, i64> {};
    for c in s.cells {
        for px in [c.top, c.bottom] {
            if px != TRANSPARENT && !index.contains(px) {
                palette.push(px);
                index.insert(px, palette.len);
            }
        }
    }

    out.push(s.width as! u8);
    out.push(height as! u8);
    out.push((palette.len & 0xFF) as! u8);
    out.push((palette.len >> 8) as! u8);
    for color in palette {
        out.push((color >> 16) as! u8);
        out.push((color >> 8 & 0xFF) as! u8);
        out.push((color & 0xFF) as! u8);
    }

    let wide = palette.len > 255;
    for c in s.cells {
        for px in [c.top, c.bottom] {
            var i = 0;
            if px != TRANSPARENT {
                let found = index.get(px);
                assert(found);
                i = found;
            }
            out.push((i & 0xFF) as! u8);
            if wide { out.push((i >> 8) as! u8); }
        }
    }
}

// "charizard" and "mega-x" make "Charizard (Mega X)".
fn form_display_name(out: u8[..64]&, base_name: const u8[:], form: const u8[:]) {
    format(out, base_name, " (");
    var capitalize = true;
    for c in form {
        if c == '-' {
            out.push(' ');
            capitalize = true;
        } else {
            out.push(if capitalize && c >= 'a' && c <= 'z' { c - 32 } else { c });
            capitalize = false;
        }
    }
    out.push(')');
}
